# Optional. If set, the tracker asks for this password on first visit.
APP_PASSWORD=

# Timezone used for "today" and the daily reminder clock.
# GitHub Actions cron is UTC; 01:00 UTC is 9:00 PM America/New_York during EDT.
TZ=America/New_York

# Where entries are stored. Defaults to ./data/entries.json
DATA_PATH=./data/entries.json

# ntfy topic — use a long random string, not a guessable word.
# Subscribe to the same topic in the ntfy app on your phone and laptop.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Public URL of this app. Included as the tap target on the ntfy alert.
APP_URL=http://localhost:3000
